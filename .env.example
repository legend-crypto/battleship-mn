# Midnight Network Environment Configuration
# Options: preview | preprod | mainnet
VITE_MIDNIGHT_NETWORK=preview

# Midnight Preview Testnet Endpoints (Default)
VITE_MIDNIGHT_TESTNET_RPC=https://rpc.preview.midnight.network
VITE_MIDNIGHT_INDEXER_URL=https://indexer.preview.midnight.network/api/v4/graphql
VITE_MIDNIGHT_EXPLORER_URL=https://preview.midnightexplorer.com
VITE_MIDNIGHT_FAUCET_URL=https://faucet.preview.midnight.network

# Blockfrost Midnight Preprod / Mainnet Endpoints (Required for Preprod & Mainnet)
VITE_MIDNIGHT_PREPROD_RPC=
VITE_MIDNIGHT_PREPROD_INDEXER_URL=
VITE_MIDNIGHT_MAINNET_RPC=
VITE_MIDNIGHT_MAINNET_INDEXER_URL=
VITE_BLOCKFROST_PROJECT_ID=

# Local Midnight Proof Server (Docker port 6300) & Compiled ZK Assets
VITE_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300
VITE_MIDNIGHT_ZK_ASSETS_URL=/midnight-zk

# Convex Backend Realtime Sync
VITE_CONVEX_URL=https://fine-rooster-248.convex.cloud

# Deployed Midnight Compact Contract Address
VITE_MIDNIGHT_CONTRACT_ADDRESS=
VITE_MIDNIGHT_MAINNET_CONTRACT_ADDRESS=

# Midnight Network Deployer Wallet (CLI deployment only - NEVER commit real keys)
# Supports 24-word MIDNIGHT_MNEMONIC, 64-byte HD MIDNIGHT_SEED, or 32-byte hex seed
MIDNIGHT_MNEMONIC=
MIDNIGHT_SEED=
MIDNIGHT_COIN_KEY=
MIDNIGHT_ENCRYPTION_KEY=
