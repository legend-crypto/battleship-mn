{
  "name": "battleship-mn",
  "version": "1.0.0",
  "private": true,
  "description": "Battleship MN monorepo - Classic Battleship with local ZK AI, real-time multiplayer, and Midnight Network staking",
  "workspaces": [
    "shared",
    "contracts",
    "backend",
    "frontend"
  ],
  "scripts": {
