    "lint": "echo 'Linting placeholder'",
    "dev:frontend": "npm run dev --workspace=frontend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "convex": "^1.18.0",
    "typescript": "^5.4.5"
  }
}
