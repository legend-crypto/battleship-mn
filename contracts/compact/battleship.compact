// ============================================================================
// BATTLESHIP MN — MIDNIGHT COMPACT SMART CONTRACT (MAINNET HARDENED SPEC)
// ============================================================================
// Security & Protocol Properties:
// 1. In-Circuit Merkle Verification:
//    Uses `persistentHash` directly inside `resolve_shot` (NO untrusted
//    witness hash/verification callbacks) so defenders cannot forge cell proofs.
// 2. Repeat-Shot Prevention:
//    Tracks every (game_id, shooter, target_coord) in `fired_shots` Map so
//    attackers cannot farm 17 hits on a single occupied cell.
// 3. Dual-Token Separation (DUST for Gas, NIGHT for Escrow):
//    Uses `receiveUnshielded` / `sendUnshielded` for wager escrow.
// 4. Liveness & Griefing Protections:
//    - `cancel_waiting_game`: Host reclaims stake anytime before P2 joins.
//    - `forfeit_game`: Voluntary surrender settles pot immediately.
//    - `claim_timeout_victory`: 60s inactivity claim via `blockTimeGreaterThan`.
//    - `emergency_refund`: 1-hour stuck-game refund for both players.
// ============================================================================

pragma language_version >= 0.14.0;
import CompactStandardLibrary;

const TOTAL_BOARD_CELLS: Uint<8> = 100;
const TOTAL_FLEET_CELLS: Uint<8> = 17;

// Timeout Thresholds (in seconds)
const DISPUTE_TIMEOUT_SECONDS: Uint<64> = 60;
const EMERGENCY_REFUND_TIMEOUT_SECONDS: Uint<64> = 3600;

enum ShipId {
  EMPTY = 0,
  CARRIER = 1,     // 5 cells
  BATTLESHIP = 2,  // 4 cells
  CRUISER = 3,     // 3 cells
  SUBMARINE = 4,   // 3 cells
  DESTROYER = 5    // 2 cells
}

enum GamePhase {
  WAITING_FOR_PLAYER2 = 0,
  IN_PROGRESS = 1,
  GAME_OVER = 2,
  REFUNDED = 3
}

enum PlayerTurn {
  PLAYER_1 = 1,
  PLAYER_2 = 2
}

struct CellLeaf {
  cell_index: Uint<8>,
  is_occupied: Boolean,
  ship_id: ShipId,
  salt: Bytes<32>
}

// Height-7 Merkle path proof (2^7 = 128 >= 100 cells)
struct MerkleProof {
  path_hashes: Vector<7, Bytes<32>>,
  path_directions: Vector<7, Boolean> // true if current node is right child
}

struct GameState {
  game_id: Bytes<32>,
  player1: Address,
  player2: Address,
  board_commitment_p1: Bytes<32>,
  board_commitment_p2: Bytes<32>,

  stake_amount_night: Uint<64>,
  total_escrow_night: Uint<64>,
  p1_staked: Boolean,
  p2_staked: Boolean,
  is_payout_claimed: Boolean,

  current_turn: PlayerTurn,
  phase: GamePhase,
  created_timestamp: Uint<64>,
  last_action_timestamp: Uint<64>,

  p1_hits_against_p2: Uint<8>,
  p2_hits_against_p1: Uint<8>,
  last_shot_coord: Uint<8>,
  pending_shot_active: Boolean,
  winner: Address
}

export ledger games: Map<Bytes<32>, GameState>;
export ledger fired_shots: Map<Bytes<32>, Boolean>;

/**
 * In-circuit domain-separated hash of a single cell leaf.
 */
pure circuit hash_cell_leaf(leaf: CellLeaf): Bytes<32> {
  const occupied_byte: Uint<8> = leaf.is_occupied ? 1 : 0;
  return persistentHash<Vector<5, Bytes<32>>>([
    pad(32, "battleship:leaf:v1"),
    (leaf.cell_index as Field) as Bytes<32>,
    (occupied_byte as Field) as Bytes<32>,
    ((leaf.ship_id as Uint<8>) as Field) as Bytes<32>,
    leaf.salt
  ]);
}

/**
 * Single Merkle parent step executed inside the ZK circuit.
 */
pure circuit merkle_step(current: Bytes<32>, sibling: Bytes<32>, is_right_child: Boolean): Bytes<32> {
  return is_right_child
    ? persistentHash<Vector<2, Bytes<32>>>([sibling, current])
    : persistentHash<Vector<2, Bytes<32>>>([current, sibling]);
}

/**
 * Unrolled 7-level Merkle root computation verified strictly inside the circuit.
 */
pure circuit verify_merkle_root(leaf_hash: Bytes<32>, proof: MerkleProof): Bytes<32> {
  const h1 = merkle_step(leaf_hash, proof.path_hashes[0], proof.path_directions[0]);
  const h2 = merkle_step(h1, proof.path_hashes[1], proof.path_directions[1]);
  const h3 = merkle_step(h2, proof.path_hashes[2], proof.path_directions[2]);
  const h4 = merkle_step(h3, proof.path_hashes[3], proof.path_directions[3]);
  const h5 = merkle_step(h4, proof.path_hashes[4], proof.path_directions[4]);
  const h6 = merkle_step(h5, proof.path_hashes[5], proof.path_directions[5]);
  return merkle_step(h6, proof.path_hashes[6], proof.path_directions[6]);
}

/**
 * Computes unique replay-protection key for (game_id, shooter, target_coord).
 */
pure circuit shot_replay_key(game_id: Bytes<32>, shooter: Address, target_coord: Uint<8>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([
    pad(32, "battleship:shot:v1"),
    game_id,
    shooter as Bytes<32>,
    (target_coord as Field) as Bytes<32>
  ]);
}

/**
 * Helper: resolves escrow token color for unshielded NIGHT deposits/payouts.
 * NOTE: Update to the canonical Midnight NIGHT token color before mainnet deploy.
 */
pure circuit escrow_token_color(): Bytes<32> {
  const domain = pad(32, "battleship:night:escrow");
  return tokenType(domain, kernel.self());
}

/**
 * CIRCUIT 1: create_game
 * Host initializes a match with their 100-cell board commitment and deposits stake.
 */
export circuit create_game(
  game_id: Bytes<32>,
  board_commitment: Bytes<32>,
  stake_amount_night: Uint<64>,
  current_timestamp: Uint<64>
): Void {
  assert !games.member(game_id), "Game ID already exists";
  assert board_commitment != pad(32, ""), "Invalid board commitment";
  assert stake_amount_night > 0, "Stake must be positive";
  assert !blockTimeLessThan(current_timestamp), "Timestamp ahead of block time";

  receiveUnshielded(escrow_token_color(), disclose(stake_amount_night) as Uint<128>);

  const new_game = GameState {
    game_id: game_id,
    player1: transaction.sender,
    player2: pad(32, ""),
    board_commitment_p1: board_commitment,
    board_commitment_p2: pad(32, ""),
    stake_amount_night: stake_amount_night,
    total_escrow_night: stake_amount_night,
    p1_staked: true,
    p2_staked: false,
    is_payout_claimed: false,
    current_turn: PlayerTurn.PLAYER_1,
    phase: GamePhase.WAITING_FOR_PLAYER2,
    created_timestamp: current_timestamp,
    last_action_timestamp: current_timestamp,
    p1_hits_against_p2: 0,
    p2_hits_against_p1: 0,
    last_shot_coord: 255,
    pending_shot_active: false,
    winner: pad(32, "")
  };

  games.insert(game_id, new_game);
}

/**
 * CIRCUIT 2: cancel_waiting_game
 * Allows Host to cancel and reclaim stake anytime before Player 2 joins.
 */
export circuit cancel_waiting_game(game_id: Bytes<32>): Void {
  assert games.member(game_id), "Game does not exist";
  var game = games.lookup(game_id);

  assert game.phase == GamePhase.WAITING_FOR_PLAYER2, "Game already started or closed";
  assert transaction.sender == game.player1, "Only host can cancel waiting game";
  assert game.p1_staked, "Host stake already refunded";

  game.p1_staked = false;
  game.phase = GamePhase.REFUNDED;

  sendUnshielded(
    escrow_token_color(),
    disclose(game.stake_amount_night) as Uint<128>,
    right<ContractAddress, UserAddress>(disclose(game.player1))
  );

  games.insert(game_id, game);
}

/**
 * CIRCUIT 3: join_game
 * Guest joins waiting match with their board commitment and deposits equal stake.
 */
export circuit join_game(
  game_id: Bytes<32>,
  board_commitment: Bytes<32>,
  current_timestamp: Uint<64>
): Void {
  assert games.member(game_id), "Game does not exist";
  var game = games.lookup(game_id);

  assert game.phase == GamePhase.WAITING_FOR_PLAYER2, "Game is not accepting player 2";
  assert transaction.sender != game.player1, "Host cannot join as player 2";
  assert board_commitment != pad(32, ""), "Invalid board commitment";
  assert !blockTimeLessThan(current_timestamp), "Timestamp ahead of block time";

  receiveUnshielded(escrow_token_color(), disclose(game.stake_amount_night) as Uint<128>);

  game.player2 = transaction.sender;
  game.board_commitment_p2 = board_commitment;
  game.p2_staked = true;
  game.total_escrow_night = game.stake_amount_night + game.stake_amount_night;
  game.phase = GamePhase.IN_PROGRESS;
  game.current_turn = PlayerTurn.PLAYER_1;
  game.last_action_timestamp = current_timestamp;

  games.insert(game_id, game);
}

/**
 * CIRCUIT 4: fire_shot
 * Active player submits target coordinate (0..99). Enforces turn order & no repeat shots.
 */
export circuit fire_shot(
  game_id: Bytes<32>,
  target_coord: Uint<8>,
  current_timestamp: Uint<64>
): Void {
  assert games.member(game_id), "Game does not exist";
  var game = games.lookup(game_id);

  assert game.phase == GamePhase.IN_PROGRESS, "Game is not in progress";
  assert !game.pending_shot_active, "Previous shot resolution pending";
  assert target_coord < TOTAL_BOARD_CELLS, "Target coordinate out of 10x10 bounds (0..99)";
  assert !blockTimeLessThan(current_timestamp), "Timestamp ahead of block time";

  if (game.current_turn == PlayerTurn.PLAYER_1) {
    assert transaction.sender == game.player1, "Turn violation: Only Player 1 can fire now";
  } else {
    assert transaction.sender == game.player2, "Turn violation: Only Player 2 can fire now";
  }

  const key = shot_replay_key(game_id, transaction.sender, target_coord);
  assert !fired_shots.member(key), "Replay violation: Coordinate already targeted";
  fired_shots.insert(key, true);

  game.last_shot_coord = target_coord;
  game.pending_shot_active = true;
  game.last_action_timestamp = current_timestamp;

  games.insert(game_id, game);
}

/**
 * CIRCUIT 5: resolve_shot
 * Defending player submits CellLeaf + MerkleProof verified strictly inside the circuit.
 */
export circuit resolve_shot(
  game_id: Bytes<32>,
  target_coord: Uint<8>,
  is_hit: Boolean,
  leaf: CellLeaf,
  proof: MerkleProof,
  current_timestamp: Uint<64>
): Void {
  assert games.member(game_id), "Game does not exist";
  var game = games.lookup(game_id);

  assert game.phase == GamePhase.IN_PROGRESS, "Game is not in progress";
  assert game.pending_shot_active, "No pending shot to resolve";
  assert game.last_shot_coord == target_coord, "Target coordinate mismatch";
  assert leaf.cell_index == target_coord, "Leaf index mismatch";
  assert leaf.is_occupied == is_hit, "Claimed hit/miss does not match cell leaf";
  assert !blockTimeLessThan(current_timestamp), "Timestamp ahead of block time";

  var target_commitment: Bytes<32> = pad(32, "");
  if (game.current_turn == PlayerTurn.PLAYER_1) {
    assert transaction.sender == game.player2, "Only defending player (P2) can resolve";
    target_commitment = game.board_commitment_p2;
  } else {
    assert transaction.sender == game.player1, "Only defending player (P1) can resolve";
    target_commitment = game.board_commitment_p1;
  }

  const leaf_hash = hash_cell_leaf(leaf);
  const computed_root = verify_merkle_root(leaf_hash, proof);
  assert computed_root == target_commitment, "Invalid Merkle proof for defender commitment";

  game.pending_shot_active = false;
  game.last_action_timestamp = current_timestamp;

  if (is_hit) {
    if (game.current_turn == PlayerTurn.PLAYER_1) {
      game.p1_hits_against_p2 = game.p1_hits_against_p2 + 1;
      if (game.p1_hits_against_p2 == TOTAL_FLEET_CELLS) {
        game.phase = GamePhase.GAME_OVER;
        game.winner = game.player1;
      }
    } else {
      game.p2_hits_against_p1 = game.p2_hits_against_p1 + 1;
      if (game.p2_hits_against_p1 == TOTAL_FLEET_CELLS) {
        game.phase = GamePhase.GAME_OVER;
        game.winner = game.player2;
      }
    }
  }

  if (game.phase != GamePhase.GAME_OVER) {
    if (game.current_turn == PlayerTurn.PLAYER_1) {
      game.current_turn = PlayerTurn.PLAYER_2;
    } else {
      game.current_turn = PlayerTurn.PLAYER_1;
    }
  }

  games.insert(game_id, game);
}

/**
 * CIRCUIT 6: forfeit_game
 * Allows either participant to voluntarily surrender and release the 2x pot to the opponent.
 */
export circuit forfeit_game(game_id: Bytes<32>): Void {
  assert games.member(game_id), "Game does not exist";
  var game = games.lookup(game_id);

  assert game.phase == GamePhase.IN_PROGRESS, "Game is not in progress";
  assert !game.is_payout_claimed, "Escrow payout already claimed";
  assert transaction.sender == game.player1 || transaction.sender == game.player2, "Not a match participant";

  if (transaction.sender == game.player1) {
    game.winner = game.player2;
  } else {
    game.winner = game.player1;
  }

  game.phase = GamePhase.GAME_OVER;
  game.is_payout_claimed = true;

  sendUnshielded(
    escrow_token_color(),
    disclose(game.total_escrow_night) as Uint<128>,
    right<ContractAddress, UserAddress>(disclose(game.winner))
  );

  games.insert(game_id, game);
}

/**
 * CIRCUIT 7: claim_winner_payout
 * Releases 2x total escrow pot to verified winner.
 */
export circuit claim_winner_payout(game_id: Bytes<32>): Void {
  assert games.member(game_id), "Game does not exist";
  var game = games.lookup(game_id);

  assert game.phase == GamePhase.GAME_OVER, "Game is not completed";
  assert !game.is_payout_claimed, "Payout already claimed";
  assert transaction.sender == game.winner, "Only verified winner can claim escrow pot";

  game.is_payout_claimed = true;
  sendUnshielded(
    escrow_token_color(),
    disclose(game.total_escrow_night) as Uint<128>,
    right<ContractAddress, UserAddress>(disclose(game.winner))
  );

  games.insert(game_id, game);
}

/**
 * CIRCUIT 8: claim_timeout_victory
 * If opponent fails to act within DISPUTE_TIMEOUT_SECONDS (60s), waiting player wins 2x pot.
 */
export circuit claim_timeout_victory(game_id: Bytes<32>): Void {
  assert games.member(game_id), "Game does not exist";
  var game = games.lookup(game_id);

  assert game.phase == GamePhase.IN_PROGRESS, "Game is not in progress";
  assert !game.is_payout_claimed, "Escrow payout already claimed";
  assert blockTimeGreaterThan(game.last_action_timestamp + DISPUTE_TIMEOUT_SECONDS), "60s dispute timeout not elapsed";

  if (game.pending_shot_active) {
    if (game.current_turn == PlayerTurn.PLAYER_1) {
      assert transaction.sender == game.player1, "Waiting on P2 to resolve; only P1 can claim";
      game.winner = game.player1;
    } else {
      assert transaction.sender == game.player2, "Waiting on P1 to resolve; only P2 can claim";
      game.winner = game.player2;
    }
  } else {
    if (game.current_turn == PlayerTurn.PLAYER_1) {
      assert transaction.sender == game.player2, "Waiting on P1 to fire; only P2 can claim";
      game.winner = game.player2;
    } else {
      assert transaction.sender == game.player1, "Waiting on P2 to fire; only P1 can claim";
      game.winner = game.player1;
    }
  }

  game.phase = GamePhase.GAME_OVER;
  game.is_payout_claimed = true;
  sendUnshielded(
    escrow_token_color(),
    disclose(game.total_escrow_night) as Uint<128>,
    right<ContractAddress, UserAddress>(disclose(game.winner))
  );

  games.insert(game_id, game);
}

/**
 * CIRCUIT 9: emergency_refund
 * After EMERGENCY_REFUND_TIMEOUT_SECONDS (1 hour) of inactivity, participants reclaim their stake.
 */
export circuit emergency_refund(game_id: Bytes<32>): Void {
  assert games.member(game_id), "Game does not exist";
  var game = games.lookup(game_id);

  assert game.phase == GamePhase.WAITING_FOR_PLAYER2 || game.phase == GamePhase.IN_PROGRESS, "Cannot refund completed game";
  assert transaction.sender == game.player1 || transaction.sender == game.player2, "Only match participants can claim refund";
  assert blockTimeGreaterThan(game.last_action_timestamp + EMERGENCY_REFUND_TIMEOUT_SECONDS), "1-hour emergency refund timeout not elapsed";

  if (transaction.sender == game.player1) {
    assert game.p1_staked, "Player 1 stake already refunded";
    game.p1_staked = false;
    sendUnshielded(
      escrow_token_color(),
      disclose(game.stake_amount_night) as Uint<128>,
      right<ContractAddress, UserAddress>(disclose(game.player1))
    );
  } else {
    assert game.p2_staked, "Player 2 stake already refunded";
    game.p2_staked = false;
    sendUnshielded(
      escrow_token_color(),
      disclose(game.stake_amount_night) as Uint<128>,
      right<ContractAddress, UserAddress>(disclose(game.player2))
    );
  }

  if (!game.p1_staked && !game.p2_staked) {
    game.phase = GamePhase.REFUNDED;
  }

  games.insert(game_id, game);
}
